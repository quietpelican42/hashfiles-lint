{
  "name": "hashfiles-lint",
  "version": "0.1.0",
  "description": "Find GitHub Actions hashFiles() patterns that match no files, so a cache key silently freezes instead of erroring.",
  "keywords": [
    "github-actions",
    "hashfiles",
    "actions-cache",
    "cache-key",
    "workflow-lint",
    "cli"
  ],
  "license": "MIT",
  "author": "__AUTHOR__",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/__GH_OWNER__/hashfiles-lint.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hashfiles-lint": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run test:dist",
    "test:dist": "node --test test/smoke.mjs"
  },
  "dependencies": {
    "@actions/glob": "^0.5.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
